# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external SEP backend URL (when omitted, built-in contract API server handles /api/v1)
SEP_BACKEND_URL=""

# OIDC configuration for external Keycloak / IdP
VITE_OIDC_AUTHORITY=""
VITE_OIDC_CLIENT_ID="sep-web"
VITE_API_BASE="/api/v1"
